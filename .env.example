# ============================================================
# Environment Variables for OSGU Library Website
# Copy this file to .env and fill in the values
# ============================================================

# Database URL — SQLite file path
# Local dev:   file:/home/z/my-project/db/custom.db
# Render.com:  file:/data/library.db (set in Render Dashboard)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Next.js
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Port (Render sets this automatically to 10000)
PORT=3000
